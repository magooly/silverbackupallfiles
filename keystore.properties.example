# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is gitignored and should stay local.

# Absolute or relative path to your release keystore (.jks)
storeFile=C:/path/to/my-release-key.jks

# Keystore password
storePassword=change_me

# Key alias inside the keystore
keyAlias=change_me

# Key password
keyPassword=change_me

