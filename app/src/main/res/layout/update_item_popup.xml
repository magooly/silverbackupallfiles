<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/row_item_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/marginplus1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/marginplus1"
                    android:layout_margin="@dimen/marginplus1"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:orientation="horizontal"
                    android:text="@string/item_type"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text=":"
                    android:layout_height="match_parent"/>

                <EditText
                    android:id="@+id/et_item_type"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/marginplus6"
                    android:layout_gravity="right"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:background="@drawable/edittext_bg"
                    android:gravity="right|center"
                    android:inputType="textCapWords"
                    android:padding="5dp"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/marginplus1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/marginplus1"
                    android:layout_margin="@dimen/marginplus1"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:orientation="horizontal"
                    android:text="@string/no"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text=":"
                    android:layout_height="match_parent"/>

                <EditText
                    android:id="@+id/et_no"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/marginplus6"
                    android:layout_alignParentRight="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="right"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:background="@drawable/edittext_bg"
                    android:gravity="right|center"
                    android:inputType="number"
                    android:digits="0123456789."
                    android:padding="5dp"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/marginplus1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginplus1"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:paddingHorizontal="@dimen/marginplus1"
                    android:orientation="horizontal"
                    android:text="@string/weight"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text=":"
                    android:layout_height="match_parent"/>

                <EditText
                    android:id="@+id/et_wight"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/marginplus6"
                    android:layout_alignParentRight="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="right"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:background="@drawable/edittext_bg"
                    android:gravity="right|center"
                    android:inputType="number"
                    android:digits="0123456789."
                    android:padding="5dp"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_what"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/marginplus1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginplus1"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:paddingHorizontal="@dimen/marginplus1"
                    android:orientation="horizontal"
                    android:text="@string/vhat"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text=":"
                    android:layout_height="match_parent"/>

                <EditText
                    android:id="@+id/et_what"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/marginplus6"
                    android:layout_alignParentRight="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="right"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:background="@drawable/edittext_bg"
                    android:gravity="right|center"
                    android:inputType="text"
                    android:padding="5dp"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/marginplus1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginplus1"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:paddingHorizontal="@dimen/marginplus1"
                    android:orientation="horizontal"
                    android:text="@string/total_oz"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text=":"
                    android:layout_height="match_parent"/>

                <EditText
                    android:id="@+id/et_total"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/marginplus6"
                    android:layout_alignParentRight="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="right"
                    android:layout_marginHorizontal="@dimen/marginplus1"
                    android:background="@drawable/edittext_bg"
                    android:gravity="right|center"
                    android:inputType="number"
                    android:enabled="false"
                    android:padding="5dp"
                    android:textColor="@color/textview_text_color"
                    android:textSize="@dimen/font_14" />


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_margin="@dimen/marginplus1"
        android:padding="@dimen/marginplus2"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/marginplus1"
            android:layout_weight="1"
            android:background="@drawable/rounded_button_border"
            android:minHeight="30dp"
            android:paddingHorizontal="@dimen/marginplus3"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary" />


        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/rounded_button_border"
            android:minHeight="30dp"
            android:paddingHorizontal="@dimen/marginplus3"
            android:layout_marginHorizontal="@dimen/marginplus1"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/rounded_button_border"
            android:minHeight="30dp"
            android:paddingHorizontal="@dimen/marginplus3"
            android:layout_marginHorizontal="@dimen/marginplus1"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@android:color/holo_red_dark" />



    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_font7"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

    </ImageView>

    </LinearLayout>

</ScrollView>

